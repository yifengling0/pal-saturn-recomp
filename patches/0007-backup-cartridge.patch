+    g_cfg.cart = cart.string();
+    run(file.string());
+    for (int slot = 0; slot < 4; ++slot)
+        CHECK_EQ(read_back(("SLOT" + std::to_string(slot)).c_str(), 300, slot, 1), 0);
+    CHECK_EQ(read_back("SLOT0", 300, 0), 5);            // and they are the cartridge's, not device 0's
