+// A game's save slots beyond the one file the internal memory holds go on the cartridge.
+TEST(cart_holds_the_saves_the_internal_memory_has_no_room_for) {
+    fs::path dir = scratch(), file = dir / "backup.bin", cart = dir / "cart.bin";
+    g_cfg.cart = "";
+    run(file.string());
+    CHECK_EQ(bup(kStat, 1, 25600, kOut), 1);            // without --cart, device 1 is not there
+    CHECK_EQ(bup(kDirList, 1, 0, 4, kOut), (uint32_t)-1);
+    g_cfg.cart = cart.string();
+    run(file.string());
+    CHECK_EQ(bup(kStat, 1, 25600, kOut), 0);
+    CHECK_EQ(ld32(kOut + 20) >= 4, 1);                  // four 25,600-byte saves fit
