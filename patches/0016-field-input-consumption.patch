+#pragma once
+#include "pal_field_input_api.h"
+#include <map>
+#include <cstdint>
+
+namespace pal_field_host {
+// Per-source live levels plus one globally coalesced, unconsumed direction edge.
+// No renderer ticks, VBlank deadlines or guest memory are involved.
+class Ledger {
+public:
+    static constexpr uint16_t Directions = 0xF000;
+    static uint16_t normalize(uint16_t value) {
+        value &= Directions;
+        if ((value & 0xC000) == 0xC000) value &= uint16_t(~0xC000);
+        if ((value & 0x3000) == 0x3000) value &= uint16_t(~0x3000);
+        return value;
+    }
+    // Original guest f060227F8's four diagonal combinations select one
+    // cardinal. Keep raw bits in held(), but never give the guest a multibit
+    // direction that its transactional single-direction guard rejects.
+    static uint16_t cardinal(uint16_t value) {
+        value = normalize(value);
+        switch (value) {
+        case 0x9000: return 0x1000; // Up + Right -> Up
+        case 0x6000: return 0x2000; // Down + Left -> Down
+        case 0x5000: return 0x4000; // Up + Left -> Left
+        case 0xA000: return 0x8000; // Down + Right -> Right
+        default: return value;
+        }
+    }
+    void context(bool active, bool discard) {
+        if (discard) {
+            ++epoch_; ++read_seq_; pending_ = {};
+            for (auto& [id, s] : sources_) if (s.raw) s.disarmed = true;
+        }
+        active_ = active;
+    }
+    bool active() const { return active_; }
+    uint64_t epoch() const { return epoch_; }
+    // explicit_down is a new physical press, never an OS repeat. Polling may
+    // also discover a fresh zero->nonzero level after a verified release.
+    void observe(uint64_t source, uint16_t direction, bool explicit_down = false) {
+        direction = normalize(direction);
+        auto it = sources_.find(source);
+        if (!direction && it == sources_.end()) return;
+        auto& s = sources_[source];
+        const uint16_t before = s.raw;
+        s.raw = direction;
+        if (!direction) {
+            s.disarmed = false;
+            prune(source);
+            return;
+        }
+        if (!active_) {
+            if (before != direction || explicit_down) s.disarmed = true;
+            return;
+        }
+        if (s.disarmed && !explicit_down) return;
+        if (explicit_down) s.disarmed = false;
+        if (s.direction != cardinal(direction) || explicit_down || !s.press) {
+            s.press = ++press_seq_;
+            s.direction = cardinal(direction);
+            pending_ = {source, s.press, epoch_, s.direction};
+        }
+    }
+    void release(uint64_t source) { observe(source, 0); }
+    void cancel(uint64_t source) {
+        if (pending_.source == source) pending_ = {};
+        sources_.erase(source);
+    }
+    // The raw peripheral retains its ordinary aggregate/conflict policy.
+    uint16_t held() const {
+        uint16_t out = 0;
+        for (const auto& [id, s] : sources_) if (!s.disarmed) out |= s.raw;
+        return out;
+    }
+    Read begin(bool blocked = false) {
+        Read out = choice();
+        out.read_seq = ++read_seq_;
+        out.active = active_;
+        out.blocked = blocked;
+        if (blocked || !active_) { out.direction = 0; out.pending = false; }
+        return out;
+    }
+    // Epoch/read ownership for an action that keeps native non-movement priority.
+    // A newer direction does not invalidate this context check or consume it.
+    bool current(const Read& read) const {
+        return active_ && read.active && !read.blocked && read.epoch == epoch_ && read.read_seq == read_seq_;
+    }
+    // Validation and consumption are one operation. UP after an unconsumed
+    // edge remains eligible once; UP after an already consumed hold is stale.
+    bool acknowledge(const Read& read) {
+        if (!active_ || !read.active || read.blocked || read.epoch != epoch_ || read.read_seq != read_seq_ || read.read_seq == acknowledged_read_) return false;
+        const Read now = choice();
+        if (now.source != read.source || now.press_seq != read.press_seq || now.direction != read.direction) return false;
+        if (read.pending) {
+            if (pending_.source != read.source || pending_.press != read.press_seq || pending_.epoch != read.epoch || pending_.direction != read.direction) return false;
+            const auto source = pending_.source;
+            pending_ = {};
+            prune(source);
+        }
+        acknowledged_read_ = read.read_seq;
+        return true;
+    }
+private:
+    struct Source { uint16_t raw = 0, direction = 0; uint64_t press = 0; bool disarmed = false; };
+    struct Pending { uint64_t source = 0, press = 0, epoch = 0; uint16_t direction = 0; };
+    std::map<uint64_t, Source> sources_;
+    Pending pending_;
+    uint64_t epoch_ = 1, press_seq_ = 0, read_seq_ = 0, acknowledged_read_ = 0;
+    bool active_ = false;
+    void prune(uint64_t source) {
+        const auto it = sources_.find(source);
+        if (it != sources_.end() && !it->second.raw && pending_.source != source) sources_.erase(it);
+    }
+    Read choice() const {
+        Read out; out.epoch = epoch_; out.held = held(); out.active = active_;
+        for (const auto& [id, s] : sources_) {
+            if (!s.disarmed && s.raw && s.press > out.press_seq) {
+                out.source = id; out.press_seq = s.press; out.direction = s.direction;
+            }
+        }
+        if (pending_.press && pending_.press >= out.press_seq) {
+            out.source = pending_.source; out.press_seq = pending_.press;
+            out.direction = pending_.direction; out.pending = true;
+        }
+        return out;
+    }
+};
