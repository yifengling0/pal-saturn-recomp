+#pragma once
+#include <cstdint>
+
+// PAL-specific field input transaction. No SDL or guest-memory types here.
+// source/press/epoch/read identities make stale acknowledgements harmless.
+namespace pal_field_host {
+struct Read {
+    uint64_t source = 0, press_seq = 0, epoch = 0, read_seq = 0;
+    uint16_t direction = 0, held = 0;
+    bool active = false, pending = false, blocked = false;
+};
+// True only for the enabled live host path, never scripted/headless playback.
+bool available();
+// Suspend capture without discarding during a synchronous guest callback;
+// discard=true is a hard boundary and disarms contacts until their release.
+void context(bool active, bool discard);
+// Service events on the SDL owner thread/safe stack without nested rendering
+// or menu waits, then freeze one complete field-direction transaction.
+Read begin();
+// Accept exactly the frozen attempt, even if the original collision blocks it.
+// Returns false if epoch/gesture/read ownership became stale; no guest writes
+// may be made for a rejected read. A valid neutral read returns true as well.
+// Read-only context validity across converter polls; never consumes an edge.
+bool current(const Read& read);
+bool acknowledge(const Read& read);
+} // namespace pal_field_host
