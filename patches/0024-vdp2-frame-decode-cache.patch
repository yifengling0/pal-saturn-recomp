+// Rebuild from the current register/CRAM view at each composition, including
+// paired snapshots and save-state restoration. No cache survives a frame.
+struct ComposeCache {
+    struct Colour { uint32_t rgb; bool msb; } palette[2048];
+    uint32_t palette_mask;
+    uint16_t spctl;
+    uint8_t prio[8], ratio[8];
+    uint32_t sprite_caos;
+    bool transparent_shadow, sprite_cc, sprite_offset, sprite_offset_b;
+    int offset[2][3];
+};
+static ComposeCache g_compose_cache;
