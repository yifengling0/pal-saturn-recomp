+static void prepare_compose_cache() {
+    auto& c = g_compose_cache;
+    c.palette_mask = cram_mode() == 1 ? 0x7FF : 0x3FF;
+    for (uint32_t i=0; i<=c.palette_mask; ++i)
+        c.palette[i].rgb = cram_decode(i, &c.palette[i].msb);
+    c.spctl = reg(0xE0);
+    for (int i=0; i<8; ++i) {
+        c.prio[i] = (uint8_t)(reg(0xF0+(i/2)*2) >> ((i&1)*8) & 7);
+        c.ratio[i] = (uint8_t)(reg(0x100+(i/2)*2) >> ((i&1)*8) & 0x1F);
+    }
+    c.sprite_caos = (uint32_t)(reg(0xE6) >> 4 & 7) << 8;
+    c.transparent_shadow = reg(0xE2) >> 8 & 1;
+    c.sprite_cc = reg(0xEC) >> 6 & 1;
+    c.sprite_offset = reg(0x110) >> 6 & 1;
+    c.sprite_offset_b = reg(0x112) >> 6 & 1;
+    for (int b=0; b<2; ++b)
+        for (int i=0; i<3; ++i)
+            c.offset[b][i] = (int)((uint32_t)(reg((b ? 0x11A : 0x114)+i*2) & 0x1FF) << 23) >> 23;
+}
+
+static uint32_t cram(uint32_t i, bool* msb) {
+    const auto& p = g_compose_cache.palette[i & g_compose_cache.palette_mask];
+    if (msb) *msb = p.msb;
+    return p.rgb;
+}
