+    int frames;
+    std::int64_t quantum_source_frames;
+    std::int64_t uncapped_frames;
+    bool valid;
+    bool capped;
+    int maximum_target;
+};
+constexpr Initial initial(int device_frames, int device_rate) noexcept {
+    // Invalid format keeps 100 ms but disables adaptation: no measured headroom.
+    if (device_frames <= 0 || device_rate <= 0) return {4410, 0, 4410, false, false, 4410};
+    const auto q = (std::int64_t{device_frames} * kSourceRate + device_rate - 1) / device_rate;
+    const auto prior = pal_audio_queue_policy::compute_lead(device_frames, device_rate);
+    // Leave one reported pull quantum plus 20 ms producer headroom below cap.
+    // Retain existing priming; a 200 ms prime plus a 93 ms pull phase can drop
+    // real PCM against a 250 ms cap, including after a menu resume.
+    const auto room = std::int64_t{kCapacity} - q - kMargin;
+    const auto limit = room < prior.source_frames ? prior.source_frames
+        : room > kMaximumTarget ? kMaximumTarget : room;
+    return {prior.source_frames, q, prior.uncapped_source_frames, true,
+            prior.maximum_applied, static_cast<int>(limit)};
+}
+
+struct Growth {
+    int silence_frames;
+    int target_after_success;
+    bool budget_exhausted;
+};
+
+// All state belongs to the sole producer. A callback publishes shortage epochs
+// atomically; it must never call these methods or mutate this state.
+struct State {
+    int target = 4410;
+    int maximum_target = 4410;
+    std::uint64_t last_epoch = 0;
+    std::uint64_t last_growth_ns = 0;
+    bool has_grown = false;
+
+    void reset(int initial_frames, std::uint64_t epoch = 0, int limit = kMaximumTarget) noexcept {
+        target = initial_frames < kMinimumInitial ? kMinimumInitial
+            : initial_frames > kMaximumInitial ? kMaximumInitial : initial_frames;
+        maximum_target = limit < target ? target : limit > kMaximumTarget ? kMaximumTarget : limit;
+        last_epoch = epoch;
+        last_growth_ns = 0;
+        has_grown = false;
+    }
+
+    // Consume each observed epoch, including during warmup/cooldown/capacity
+    // blocks, so an old startup/pause shortage cannot trigger growth later.
+    // Call with active time (or explicitly suppress/reset on pause/resume).
+    Growth observe(std::uint64_t active_ns, std::uint64_t shortage_epoch,
+                   std::int64_t raw_queued_bytes, int real_frames) noexcept {
+        const bool fresh = shortage_epoch != last_epoch;
+        last_epoch = shortage_epoch;
+        if (!fresh || active_ns < kWarmupNs) return {0, target, false};
+        if (has_grown && (active_ns < last_growth_ns || active_ns - last_growth_ns < kCooldownNs))
+            return {0, target, false};
+        if (target >= maximum_target) return {0, target, true};
+        const auto q = pal_audio_queue_policy::inspect_queued_bytes(raw_queued_bytes);
+        if (!q.ok() || real_frames <= 0 || real_frames > kCapacity || q.source_frames > kCapacity - real_frames)
+            return {0, target, false};
+        const int step = target + kGrowStep > maximum_target ? maximum_target - target : kGrowStep;
+        const auto room = std::int64_t{kCapacity} - real_frames - q.source_frames;
+        // Do not silently spend a partial growth budget: original PCM has priority.
+        if (room < step) return {0, target, false};
+        return {step, target + step, false};
+    }
+
+    // Advance the target only after the padding Put succeeds. A failed Put
+    // consumes its epoch but not the finite latency budget; retry only on a
+    // genuinely new shortage after the cooldown condition is met.
+    void commit(const Growth& growth, bool silence_put_succeeded, std::uint64_t active_ns) noexcept {
+        if (!silence_put_succeeded || growth.silence_frames <= 0 ||
+            growth.target_after_success != target + growth.silence_frames ||
+            growth.target_after_success > maximum_target) return;
+        target = growth.target_after_success;
+        last_growth_ns = active_ns;
+        has_grown = true;
+    }
+};
+} // namespace pal_audio_jitter_policy
+#endif
