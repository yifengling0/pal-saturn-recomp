+// --watch LO:HI: every address in the range, one by one. The entry points below call it for
+// both directions, so a device the game waits on (the CD block's answers, the VDP2 registers,
+// which are not memory areas) can be watched as well; the value is the word that went out or
+// the word that came back.
+static std::map<std::pair<uint32_t, char>, uint64_t> g_watch;
+static uint32_t g_watch_lo = 1, g_watch_hi = 0;
+
+static void watch_hit(uint32_t a, char rw, uint32_t v, int size) {
+    if (a < g_watch_lo || a > g_watch_hi) return;
+    ++g_watch[{a, rw}];
+    uint64_t blank = sat_vblanks();
+    bool window = g_cfg.watch_from || g_cfg.watch_to != ~0ull;   // --watch-vblanks: printed, --trace or not
+    if (window && blank >= g_cfg.watch_from && blank <= g_cfg.watch_to)
+        sat_note("watch %c %08X = %08X (%d bytes, pr %08X, VBlank %llu)", rw, a, v, size, g_cpu->pr,
+                 (unsigned long long)blank);
+    else if (!window)
+        sat_trace("watch %c %08X = %08X (%d bytes, pr %08X)", rw, a, v, size, g_cpu->pr);
+}
+
 // A register access costs the CPU a safe point of time: a loop that waits on a
 // device (a status register, the CD block's answers) lets time move on.
 static void log_reg(uint32_t a, int size, char rw) {
     ++g_regs[{a, size, rw}];
     --g_cpu->budget;
 }
