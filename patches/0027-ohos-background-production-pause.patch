+#ifdef PAL_OHOS_AUDIO_PULL
+// OHOS keeps SDL_PollEvent running in the background. Park guest production
+// on the real SDL thread stack, while still servicing lifecycle/quit events.
+static void wait_in_background() {
+    const auto began = Clock::now();
+    tasks_on_thread_stack([](void*) {
+        HostCall in("PAL background pause");
+        while (pal_ohos_audio::backgrounded()) {
+            SDL_Event e;
+            while (SDL_PollEvent(&e)) {
+                on_event(e);
+                if (e.type == SDL_EVENT_QUIT) return;
+            }
+            if (pal_ohos_audio::backgrounded()) SDL_Delay(10);
+        }
+    }, nullptr);
+    // Exclude the pause from wall-clock pacing, as the host menu already does.
+    g_base += Clock::now() - began;
+}
+#endif
