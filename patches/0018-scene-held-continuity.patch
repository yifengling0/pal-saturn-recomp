diff --git a/runtime/src/host/host.cpp b/runtime/src/host/host.cpp
--- a/runtime/src/host/host.cpp
+++ b/runtime/src/host/host.cpp
@@ -1401,6 +1401,22 @@
 void context(bool active, bool discard) {
     if (!SDL_IsMainThread()) return;
     if (!available()) { g_field_mode = false; g_field_ledger.context(false, true); return; }
+    if (active && !discard && g_field_ledger.scene_suspended()) {
+        // Drain loading-time events while capture is still suspended. Arming
+        // first would turn a queued DOWN+UP into an owed field tap. A hard
+        // event during this drain must also veto the requested reactivation.
+        if (g_field_servicing) { context(false, true); return; }
+        const auto epoch = g_field_ledger.epoch();
+        {
+            struct Guard { Guard(){g_field_servicing=true;} ~Guard(){g_field_servicing=false;} } guard;
+            tasks_on_thread_stack([](void*) { events(); }, nullptr);
+        }
+        if (!available() || !g_field_focus || !g_field_foreground || g_menu_open || g_quitting) {
+            context(false, true);
+            return;
+        }
+        if (g_field_ledger.epoch() != epoch || !g_field_ledger.scene_suspended()) return;
+    }
     if (active && !g_field_mode) g_pal_taps[0].forget(kFieldDirections);
     if (active) g_field_mode = true;
     else if (discard) g_field_mode = false;
@@ -1409,6 +1425,18 @@
         g_field_touches.clear();
     }
     g_field_ledger.context(active && g_field_focus && g_field_foreground && !g_menu_open && !g_quitting, discard);
+}
+void scene_suspend(bool preserve_existing_only) {
+    if (!SDL_IsMainThread()) return;
+    if (!available() || g_field_servicing || !g_field_focus || !g_field_foreground || g_menu_open || g_quitting) {
+        context(false, true);
+        return;
+    }
+    // Retain live touch identities and their existing armed bit. The ledger
+    // keeps only already-eligible continuous holds and drops every pending
+    // tap. New touch DOWNs while suspended stay unarmed, even after resume.
+    g_field_mode = false;
+    g_field_ledger.scene_suspend(preserve_existing_only);
 }
 Read begin() {
     if (!SDL_IsMainThread()) { Read out; out.blocked=true; return out; }
