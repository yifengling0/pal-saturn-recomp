+// Mobile v2 geometry, in renderer output pixels. This uses SDL's display scale plus
+// a short-edge floor so a backend reporting scale=1 cannot make tablet keys tiny.
+// Density is a backend observation, not a verified physical-DP measurement.
+#pragma once
+#include "touch_pad.h"
+
+inline TouchLayout touch_mobile_layout(int width, int height, float density, int size, int spacing) {
+    TouchLayout l{};
+    if (width <= 0 || height <= 0) return l;
+    const float w = (float)width, h = (float)height, s = std::min(w, h);
+    const float d = std::isfinite(density) && density > 0 ? density : 1;
+    const float scale = std::clamp(size, 50, 200) / 100.0f;
+    const float margin = std::min(std::max(24*d, .03f*s), .10f*s);
+    const float utility = std::min(std::max(48*d, .07f*s), .20f*s);
+    float gap = std::max(8*d, .018f*s) * std::clamp(spacing, 50, 200) / 100.0f;
+    gap = std::min(gap, .06f*s);
+    float button = std::max(56*d, .10f*s) * scale;
+    float cross = std::max(144*d, .28f*s) * scale;
+    const float start_width = std::min(std::max(96*d, .18f*s), .40f*w);
+    // Start stays between the lower groups when there is room. On narrow displays
+    // it and Menu share the shoulder row, never float over the six-button grid.
+    bool header = w - 2*margin - cross - (3*button+2*gap) < start_width + utility + 3*gap;
+    const float body_height = std::max(1.0f, h - 2*margin - utility - gap);
+    cross=std::min(cross,body_height);
+    button=std::min(button,std::max(1.0f,(body_height-gap)/2));
+    // On compact portrait screens shrink the cross first (down to 96 logical
+    // units), so six default-size keys do not become tiny merely to retain a huge cross.
+    cross=std::min(cross,std::max(std::min(cross,96*d),w-2*margin-3*button-3*gap));
+    button=std::min(button,std::max(1.0f,(w-2*margin-cross-3*gap)/3));
+    const float fit=std::min(1.0f,std::max(1.0f,w-2*margin-3*gap)/(cross+3*button));
+    cross*=fit; button*=fit;
+    // Shared lower edge and shoulder baseline; equal ABC/XYZ targets.
+    const float bottom = h-margin, right_width=3*button+2*gap;
+    l.dpad_r=cross/2; l.dpad_hit_r=l.dpad_r; l.dpad_x=margin+cross/2; l.dpad_y=bottom-cross/2;
+    const char* low[]={"A","B","C"}; const char* high[]={"X","Y","Z"};
+    const uint16_t low_bits[]={B_A,B_B,B_C}, high_bits[]={B_X,B_Y,B_Z};
+    for(int i=0;i<3;++i) {
+        float x=w-margin-right_width+button/2+i*(button+gap);
+        l.buttons.push_back({low[i],low_bits[i],TouchButton::Round,x,bottom-button/2,button/2,button/2});
+        l.buttons.push_back({high[i],high_bits[i],TouchButton::Round,x,bottom-1.5f*button-gap,button/2,button/2});
+    }
+    const float shoulder_y=bottom-std::max(cross,2*button+gap)-gap-utility/2;
+    float shoulder_w=std::min(std::max(96*d,.19f*s),std::min(cross,right_width));
+    if(header) shoulder_w=std::min(shoulder_w,std::max(1.0f,(w-2*margin-start_width-utility-3*gap)/2));
+    l.buttons.push_back({"L",B_L,TouchButton::Shoulder,header?margin+shoulder_w/2:l.dpad_x,shoulder_y,shoulder_w,utility});
+    l.buttons.push_back({"R",B_R,TouchButton::Shoulder,header?w-margin-shoulder_w/2:w-margin-right_width/2,shoulder_y,shoulder_w,utility});
+    l.menu_r=utility/2; l.menu_hit_r=l.menu_r;
+    if(header) {
+        l.menu_x=w/2+(start_width+gap)/2; l.menu_y=shoulder_y;
+        l.buttons.push_back({"START",B_START,TouchButton::Pill,w/2-(utility+gap)/2,l.menu_y,start_width,utility});
+    } else {
+        l.menu_x=w/2+(start_width+gap)/2; l.menu_y=bottom-utility/2;
+        l.buttons.push_back({"START",B_START,TouchButton::Pill,w/2-(utility+gap)/2,l.menu_y,start_width,utility});
+    }
+    return l;
+}
