+// Original PAL implementation: persist group centres as normalized usable-area
+// positions (0..10000); -1 retains the adaptive default. The entire drawn group,
+// including its shadow, is clamped, rather than only clamping its centre.
+#pragma once
+#include "touch_mobile_layout.h"
+#include <array>
+
+enum class TouchGroup { Dpad, Face, Left, Right, Start, Menu, Count };
+constexpr int kTouchGroups=(int)TouchGroup::Count;
+struct TouchPosition { int x=-1,y=-1; };
+using TouchPositions=std::array<TouchPosition,kTouchGroups>;
+struct TouchBounds {float x=0,y=0,w=0,h=0;};
+inline const char* touch_position_key(int i,bool y) {
+    static const char* xkeys[]={"dpad_x","face_x","left_x","right_x","start_x","menu_x"};
+    static const char* ykeys[]={"dpad_y","face_y","left_y","right_y","start_y","menu_y"};
+    return y?ykeys[i]:xkeys[i];
+}
+inline bool touch_group_button(TouchGroup group,const TouchButton& b) {
+    if(group==TouchGroup::Face) return b.bit==B_A||b.bit==B_B||b.bit==B_C||b.bit==B_X||b.bit==B_Y||b.bit==B_Z;
+    return group==TouchGroup::Left?b.bit==B_L:group==TouchGroup::Right?b.bit==B_R:group==TouchGroup::Start?b.bit==B_START:false;
+}
+inline TouchBounds touch_group_bounds(const TouchLayout& l,TouchGroup group) {
+    if(group==TouchGroup::Dpad){float r=1.08f*l.dpad_r;return {l.dpad_x-r,l.dpad_y-r,2*r,2*r};}
+    if(group==TouchGroup::Menu)return {l.menu_x-l.menu_r,l.menu_y-l.menu_r,2*l.menu_r,2*l.menu_r};
+    bool found=false;float left=0,top=0,right=0,bottom=0;
+    for(const auto& b:l.buttons)if(touch_group_button(group,b)) {
+        float hw=b.shape==TouchButton::Round?1.1f*b.w:b.w/2+4;
+        float hh=b.shape==TouchButton::Round?1.1f*b.w:b.h/2+4;
+        if(!found){left=b.x-hw;right=b.x+hw;top=b.y-hh;bottom=b.y+hh;found=true;}
+        else{left=std::min(left,b.x-hw);right=std::max(right,b.x+hw);top=std::min(top,b.y-hh);bottom=std::max(bottom,b.y+hh);}
+    }
+    return {left,top,right-left,bottom-top};
+}
+inline void touch_translate_group(TouchLayout& l,TouchGroup group,float dx,float dy) {
+    if(group==TouchGroup::Dpad){l.dpad_x+=dx;l.dpad_y+=dy;}
+    else if(group==TouchGroup::Menu){l.menu_x+=dx;l.menu_y+=dy;}
+    else for(auto& b:l.buttons)if(touch_group_button(group,b)){b.x+=dx;b.y+=dy;}
+}
+inline float touch_position_margin(int w,int h,float density) {
+    float d=std::isfinite(density)&&density>0?density:1;
+    return std::min(std::max(24*d,.03f*std::min(w,h)),.1f*std::min(w,h));
+}
+inline float touch_clamped_center(float center,float extent,float length,float margin) {
+    const float lo=margin+extent/2,hi=length-margin-extent/2;
+    return hi<lo?length/2:std::clamp(center,lo,hi);
+}
+inline float touch_position_center(int normalized,float original,float extent,float length,float margin) {
+    const float lo=margin+extent/2,hi=length-margin-extent/2;
+    if(normalized<0)return touch_clamped_center(original,extent,length,margin);
+    return hi<lo?length/2:lo+(hi-lo)*std::clamp(normalized,0,10000)/10000.f;
+}
+inline int touch_normalized_center(float center,float extent,float length,float margin) {
+    const float lo=margin+extent/2,hi=length-margin-extent/2;
+    return hi<=lo?5000:(int)std::lround(10000*std::clamp((center-lo)/(hi-lo),0.f,1.f));
+}
+inline TouchLayout touch_positioned(TouchLayout layout,int w,int h,float density,const TouchPositions& positions) {
+    float margin=touch_position_margin(w,h,density);
+    for(int i=0;i<kTouchGroups;++i){auto group=(TouchGroup)i;auto b=touch_group_bounds(layout,group);float cx=b.x+b.w/2,cy=b.y+b.h/2;
+        touch_translate_group(layout,group,touch_position_center(positions[i].x,cx,b.w,w,margin)-cx,touch_position_center(positions[i].y,cy,b.h,h,margin)-cy);
+    }
+    return layout;
+}
+inline TouchPosition touch_position_for_center(const TouchLayout& layout,TouchGroup group,int w,int h,float density,float x,float y) {
+    auto b=touch_group_bounds(layout,group);float margin=touch_position_margin(w,h,density);
+    return {touch_normalized_center(x,b.w,w,margin),touch_normalized_center(y,b.h,h,margin)};
+}
