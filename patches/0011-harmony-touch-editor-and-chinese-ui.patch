+#!/usr/bin/env python3
+"""Regenerate the exact-glyph host menu font headers from locally supplied Noto TTCs.
+Requires fontTools 4.61.1 (already present in the audited build environment).
+No downloads; normal runtime builds only consume the generated C++ headers.
+"""
+from pathlib import Path
+import argparse, hashlib, io, json, re
+from fontTools import subset, version
+from fontTools.ttLib import TTFont
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+p = argparse.ArgumentParser(description=__doc__)
+p.add_argument('--source-dir', type=Path, default=Path('/usr/share/fonts/opentype/noto'))
+a = p.parse_args()
+labels = (ROOT / 'src/host/host_menu_text.h').read_text()
+strings = re.findall(r'"([^"\\]*(?:\\.[^"\\]*)*)"', labels)
+codes = sorted({ord(c) for s in strings for c in s if ord(c) > 127})
+if not codes or len(codes) > 128:
+    raise SystemExit('Expected a small, explicit host-menu glyph set (1..128).')
+manifest = {'generator': 'generate.py', 'fontTools': version,
+            'upstream': 'https://github.com/notofonts/noto-cjk',
+            'upstream_license': 'https://github.com/notofonts/noto-cjk/blob/main/Sans/LICENSE',
+            'license': 'SIL Open Font License 1.1', 'face': 'Noto Sans CJK SC',
+            'face_index': 2, 'glyph_count': len(codes),
+            'codepoints': [f'U+{c:04X}' for c in codes], 'files': []}
+for weight in ('Regular', 'Bold'):
+    source = a.source_dir / f'NotoSansCJK-{weight}.ttc'
+    font = TTFont(source, fontNumber=2, recalcTimestamp=False)
+    if font['name'].getDebugName(1) != 'Noto Sans CJK SC':
+        raise SystemExit('Input face mismatch; require Simplified Chinese face 2.')
+    missing = set(codes) - set(font.getBestCmap())
+    if missing:
+        raise SystemExit(f'Missing source glyphs: {sorted(missing)}')
+    copyright_text = font['name'].getDebugName(0)
+    original_version = font['name'].getDebugName(5)
+    options = subset.Options()
+    options.layout_features = []
+    options.name_IDs = [0,1,2,3,4,5,6,13,14,16,17]
+    options.name_legacy = True
+    options.name_languages = ['*']
+    # Only the requested Unicode repertoire, no substitutions or vertical layout.
+    options.drop_tables += ['BASE', 'VORG', 'vhea', 'vmtx', 'GDEF', 'GPOS', 'GSUB']
+    sub = subset.Subsetter(options=options)
+    sub.populate(unicodes=codes)
+    sub.subset(font)
+    family = 'PAL Host Menu SC'
+    full = family + ' ' + weight
+    ps = 'PALHostMenuSC-' + weight
+    for entry in list(font['name'].names):
+        replacements = {1:family, 2:weight, 3:'PALHostMenuSC-subset-1.0-' + weight,
+                        4:full, 6:ps, 16:family, 17:weight}
+        if entry.nameID in replacements:
+            font['name'].setName(replacements[entry.nameID], entry.nameID,
+                                 entry.platformID, entry.platEncID, entry.langID)
+    # Embed full OFL and notices in each font's readable name metadata as well
+    # as shipping LICENSE.txt, so compiled distributions carry the license.
+    license_text = (HERE / 'LICENSE.txt').read_text()
+    font['name'].setName(license_text, 13, 3, 1, 0x409)
+    cff = font['CFF '].cff
+    cff.fontNames = [ps]
+    top = cff.topDictIndex[0]
+    top.FullName, top.FamilyName = full, family
+    if hasattr(top, 'FontName'):
+        top.FontName = ps
+    if hasattr(top, 'FDArray'):
+        for index, fd in enumerate(top.FDArray):
+            if hasattr(fd, 'FontName'):
+                fd.FontName = ps + f'-FD{index}'
+    # Preserve original font copyright/license metadata. Stable timestamps make
+    # generation byte-identical with the documented source and fontTools version.
+    font['head'].created = font['head'].modified = 0xD8791480
+    out = io.BytesIO()
+    font.save(out, reorderTables=True)
+    data = out.getvalue()
+    check = TTFont(io.BytesIO(data), recalcTimestamp=False)
+    assert set(check.getBestCmap()) == set(codes)
+    assert check['name'].getDebugName(0) == copyright_text
+    assert check['name'].getDebugName(1) == family
+    assert check['name'].getDebugName(13) is not None
+    symbol = 'pal_menu_cjk_' + weight.lower()
+    header = '// Generated exact-glyph font subset; do not edit.\n'
+    header += '// Derived from Noto Sans CJK SC. Copyright 2014-2021 Adobe.\n'
+    header += '// Font bytes are licensed under SIL OFL 1.1; see LICENSE.txt and README.md.\n#pragma once\n'
+    header += f'static const unsigned char {symbol}[] = {{\n'
+    header += ''.join('    ' + ', '.join(f'0x{x:02x}' for x in data[i:i+16]) + ',\n' for i in range(0,len(data),16))
+    header += '};\n'
+    (HERE / f'{symbol}.h').write_text(header)
+    manifest['files'].append({'source': source.name, 'source_sha256': hashlib.sha256(source.read_bytes()).hexdigest(),
+                            'original_version': original_version, 'copyright': copyright_text,
+                            'subset_family': family, 'subset_ps_name': ps, 'bytes':len(data),
+                            'subset_sha256': hashlib.sha256(data).hexdigest(), 'header':symbol+'.h'})
+(HERE / 'glyphs.h').write_text('// Generated from the non-ASCII label characters; see generate.py.\n#pragma once\nstatic const int kMenuCjk[] = {\n    ' + ', '.join(f'0x{c:04X}' for c in codes) + '\n};\n')
+(HERE / 'manifest.json').write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + '\n')
+print(f'Generated {len(codes)} exact glyphs per weight; {sum(f["bytes"] for f in manifest["files"])} embedded font bytes.')
