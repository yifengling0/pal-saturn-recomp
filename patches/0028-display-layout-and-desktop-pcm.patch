+#pragma once
+#include "touch_mobile_layout.h"
+
+// A narrow book/right-hand panel stacks the cross above the six keys.
+// Wide laptop/bottom panels retain the existing two-thumb mobile geometry.
+inline TouchLayout touch_split_pad(int width,int height,float density,int size,int spacing) {
+    if(width<=0||height<=0||width>=height*.75f)return touch_mobile_layout(width,height,density,size,spacing);
+    const float w=(float)width,h=(float)height,s=std::min(w,h);
+    const float d=std::isfinite(density)&&density>0?density:1;
+    const float multiplier=std::clamp(size,50,200)/100.f;
+    const float m=std::min(std::max(24*d,.03f*s),.1f*s);
+    const float utility=std::min(std::max(48*d,.07f*s),.18f*s);
+    const float gap=std::min(std::max(8*d,.018f*s)*std::clamp(spacing,50,200)/100.f,.06f*s);
+    const float body=std::max(1.f,h-2*m-2*utility-4*gap);
+    const float button=std::min({std::max(56*d,.1f*s)*multiplier,(w-2*m-2*gap)/3,body/3.5f});
+    const float cross=std::min({std::max(144*d,.28f*s)*multiplier,(w-2*m)/1.08f,(body-2*button-gap)/1.08f});
+    TouchLayout l{};
+    l.dpad_x=w/2;l.dpad_y=m+2*utility+3*gap+cross*.54f;l.dpad_r=cross/2;l.dpad_hit_r=l.dpad_r;
+    const char* low[]={"A","B","C"};const char* high[]={"X","Y","Z"};
+    const uint16_t lb[]={B_A,B_B,B_C},hb[]={B_X,B_Y,B_Z};
+    for(int i=0;i<3;++i) {
+        const float x=w/2+(i-1)*(button+gap),y=h-m-button*.55f;
+        l.buttons.push_back({low[i],lb[i],TouchButton::Round,x,y,button/2,button/2});
+        l.buttons.push_back({high[i],hb[i],TouchButton::Round,x,y-button-gap,button/2,button/2});
+    }
+    const float shoulder=(w-2*m-gap)/2,sy=m+1.5f*utility+gap;
+    l.buttons.push_back({"L",B_L,TouchButton::Shoulder,m+shoulder/2,sy,shoulder,utility});
+    l.buttons.push_back({"R",B_R,TouchButton::Shoulder,w-m-shoulder/2,sy,shoulder,utility});
+    const float start=std::min(std::max(96*d,.18f*s),w-2*m-utility-gap);
+    l.buttons.push_back({"START",B_START,TouchButton::Pill,m+start/2,m+utility/2,start,utility});
+    l.menu_x=w-m-utility/2;l.menu_y=m+utility/2;l.menu_r=utility/2;l.menu_hit_r=l.menu_r;
+    return l;
+}
