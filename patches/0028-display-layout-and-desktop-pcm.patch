+#pragma once
+#include "touch_ui_policy.h"
+#include <array>
+#include <string>
+namespace pal_display {
+using Rect=TouchGameViewport;
+struct Fold { bool half=false; int count=0; std::array<Rect,4> creases{}; };
+struct Regions {Rect game{},controls{};bool split=false;};
+inline bool same(const Regions& a,const Regions& b) {
+    return a.split==b.split&&a.game.x==b.game.x&&a.game.y==b.game.y&&a.game.w==b.game.w&&a.game.h==b.game.h&&
+        a.controls.x==b.controls.x&&a.controls.y==b.controls.y&&a.controls.w==b.controls.w&&a.controls.h==b.controls.h;
+}
+inline Regions regions(int width,int height,const std::string& mode,int percent,const Fold& fold) {
+    const float w=(float)std::max(0,width),h=(float)std::max(0,height);
+    Regions result{{0,0,w,h},{0,0,w,h},false};
+    if(w==0||h==0||mode=="overlay")return result;
+    const float ratio=std::clamp(percent,30,70)/100.f;
+    if(mode=="below")return {{0,0,w,std::floor(h*ratio)},{0,std::floor(h*ratio),w,h-std::floor(h*ratio)},true};
+    if(mode=="right")return {{0,0,std::floor(w*ratio),h},{std::floor(w*ratio),0,w-std::floor(w*ratio),h},true};
+    if(mode!="auto"||!fold.half)return result;
+    float best=2;
+    for(int i=0;i<std::clamp(fold.count,0,4);++i) {
+        auto c=fold.creases[i];
+        if(!std::isfinite(c.x)||!std::isfinite(c.y)||!std::isfinite(c.w)||!std::isfinite(c.h)||c.w<0||c.h<0)continue;
+        const float x=std::clamp(c.x,0.f,1.f),y=std::clamp(c.y,0.f,1.f);
+        const float right=std::clamp(c.x+c.w,0.f,1.f),bottom=std::clamp(c.y+c.h,0.f,1.f);
+        if(c.w>=.8f&&c.h<.2f&&y>=.2f&&bottom<=.8f&&std::fabs(y-.5f)<best) {
+            best=std::fabs(y-.5f);result={{0,0,w,std::floor(y*h)},{0,std::ceil(bottom*h),w,h-std::ceil(bottom*h)},true};
+        } else if(c.h>=.8f&&c.w<.2f&&x>=.2f&&right<=.8f&&std::fabs(x-.5f)<best) {
+            best=std::fabs(x-.5f);result={{0,0,std::floor(x*w),h},{std::ceil(right*w),0,w-std::ceil(right*w),h},true};
+        }
+    }
+    return result;
+}
+} // namespace pal_display
