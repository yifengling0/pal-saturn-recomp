+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstring>
+namespace pal_pcm {
+template<int Frames> class Batch {
+    std::array<int16_t,Frames*2> data{};
+    int used=0;
+public:
+    void clear() noexcept {used=0;}
+    template<class Sink> void push(const int16_t* pcm,int frames,Sink sink) {
+        if(!pcm||frames<=0)return;
+        while(frames>0) {
+            int n=std::min(frames,Frames-used);
+            std::memcpy(data.data()+used*2,pcm,n*4);used+=n;pcm+=n*2;frames-=n;
+            if(used==Frames){sink(data.data(),Frames);used=0;}
+        }
+    }
+};
+inline int source_quantum(int frames,int rate) {
+    if(frames<=0||rate<=0)return 1024;
+    return (int)std::min<int64_t>(11025,(int64_t(frames)*44100+rate-1)/rate);
+}
+inline int desktop_lead(int frames,int rate) {
+    // One device pull + 40ms scheduling margin, at least 50ms, at most 100ms.
+    return std::clamp(source_quantum(frames,rate)+1764,2205,4410);
+}
+inline int desktop_limit(int prime,int frames,int rate) {
+    return std::min(11025,((prime+source_quantum(frames,rate)+255)/256)*256);
+}
+} // namespace pal_pcm
