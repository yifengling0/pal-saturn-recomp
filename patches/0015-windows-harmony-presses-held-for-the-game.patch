+// A tap that begins and ends between two polls is invisible to SDL_GetKeyboardState and to a
+// gamepad's live buttons, so the event is the only proof the player pressed it at all. The menu's own
+// keys stay out of here: they navigate the menu, and what the menu leaves behind is its business.
+static void pal_note_press(const SDL_Event& e) {
+    if (g_menu_open) return;
+    uint16_t bits = 0;
+    int slot = 0;
+    if (e.type == SDL_EVENT_KEY_DOWN && !e.key.repeat) {
+        for (auto& [key, bit] : g_keys) if (key == e.key.scancode) bits |= bit;
+    } else if (e.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN) {
+        for (auto& p : g_pads) {
+            if (p.id != e.gbutton.which) continue;
+            slot = g_slots.slot_of(p.id);
+            for (auto& in : p.map.inputs) if (in.button == (int)e.gbutton.button) bits |= in.bit;
+        }
+    }
+    if (bits && slot >= 0) g_pal_taps[slot].press(bits);
+}
