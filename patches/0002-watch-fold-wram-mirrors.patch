 #define SH2_WATCH(a, v, size) \
-    do { if (SH2_UNLIKELY(((a) & 0xDFFFFFFFu) - g_sh2_watch_lo < g_sh2_watch_len)) sh2_watch_store(a, v, size); } while (0)
