+// Fixed-hit-target paging policy used by the compact host menu.
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <vector>
+struct PagingRect { float x,y,w,h; };
+struct PagingInsets { float left=0,top=0,right=0,bottom=0; };
+enum class PagingKind { Main, Touch, Picture };
+struct PagingPlan {
+    bool viable=false;
+    int columns=1, rows=0, items_per_page=0, pages=0;
+    PagingRect panel{},back{},next{};
+    std::vector<PagingRect> cells;
+};
+inline PagingPlan fixed_hit_paging(int pixel_w,int pixel_h,float scale,PagingInsets insets,
+                                  PagingKind kind,int item_count) {
+    PagingPlan p;
+    if (!std::isfinite(scale) || scale<=0) scale=1;
+    const float sw=(pixel_w-insets.left-insets.right)/scale;
+    const float sh=(pixel_h-insets.top-insets.bottom)/scale;
+    constexpr float margin=8, header=48, gap=8, row=48;
+    // 120 = 8 top + 48 header + 8 gap + 48 row + 8 bottom.
+    if (sw<320 || sh<120 || item_count<=0) return p; // fallback required; never silently shrink hits
+    int fit_rows=std::max(0,(int)std::floor((sh-64)/56));
+    if (kind==PagingKind::Touch || kind==PagingKind::Picture) fit_rows=std::min(fit_rows,3);
+    if (fit_rows<=0) return p;
+    if (kind==PagingKind::Main && item_count>fit_rows && sw>=328) p.columns=2;
+    p.rows=std::min(fit_rows,(item_count+p.columns-1)/p.columns);
+    p.items_per_page=p.rows*p.columns;
+    p.pages=(item_count+p.items_per_page-1)/p.items_per_page;
+    const float pw=std::min(sw,720.f), ph=margin+header+gap+p.rows*row+(p.rows-1)*gap+margin;
+    const float px=insets.left+(sw-pw)/2*scale,py=insets.top+(sh-ph)/2*scale;
+    p.panel={px,py,pw*scale,ph*scale};
+    p.back={px+margin*scale,py+margin*scale,48*scale,48*scale};
+    p.next={px+(pw-margin-48)*scale,py+margin*scale,48*scale,48*scale};
+    const float cell_w=(pw-2*margin-(p.columns-1)*gap)/p.columns;
+    if (cell_w<48) return PagingPlan{};
+    for(int i=0;i<p.items_per_page;++i) p.cells.push_back({px+(margin+(i%p.columns)*(cell_w+gap))*scale,
+        py+(margin+header+gap+(i/p.columns)*(row+gap))*scale,cell_w*scale,row*scale});
+    p.viable=true;return p;
+}
