+#ifndef PAL_AUDIO_QUEUE_POLICY_H
+#define PAL_AUDIO_QUEUE_POLICY_H
+
+// Standalone C++17 policy candidate. No SDL, allocation, clocks or side effects.
+// Input is fixed 16-bit interleaved stereo PCM at 44100 Hz. Device frame counts
+// must be converted to that input timebase before they are used as a lead.
+// This preserves the existing 50..100 ms lead bounds and 250 ms input-queue cap.
+// It does not diagnose hardware underruns or decide when recovery is desirable.
+#include <cstdint>
+
+namespace pal_audio_queue_policy {
+
+inline constexpr std::int32_t kSourceRate = 44100;
+inline constexpr std::int32_t kSourceFrameBytes = 4;
+inline constexpr std::int32_t kMinimumLeadFrames = 2205;
+inline constexpr std::int32_t kMaximumLeadFrames = 4410;
+inline constexpr std::int32_t kMaximumQueuedFrames = 11025;
+
+struct LeadResult {
+    std::int32_t source_frames;
+    std::int64_t uncapped_source_frames;
+    bool valid_device_format;
+    bool maximum_applied;
+};
+
+// device_frames/device_rate are signed 32-bit values returned by SDL.
+// Widen before multiplication. For their complete positive input range,
+// 3 * INT32_MAX * 44100 + INT32_MAX - 1 fits in signed 64 bits.
+constexpr LeadResult compute_lead(std::int32_t device_frames,
+                                  std::int32_t device_rate) noexcept {
+    if (device_frames <= 0 || device_rate <= 0) {
+        return {kMinimumLeadFrames, kMinimumLeadFrames, false, false};
+    }
+    const std::int64_t raw =
+        (std::int64_t{3} * device_frames * kSourceRate + device_rate - 1)
+        / device_rate;
+    const std::int64_t bounded = raw < kMinimumLeadFrames
+        ? kMinimumLeadFrames
+        : (raw > kMaximumLeadFrames ? kMaximumLeadFrames : raw);
+    return {static_cast<std::int32_t>(bounded), raw, true,
+            raw > kMaximumLeadFrames};
+}
+
+enum class QueueError {
+    none,
+    query_failed,
+    not_whole_source_frames,
+    invalid_argument,
+};
+
+struct QueueResult {
+    QueueError error;
+    std::int64_t source_frames;
+    constexpr bool ok() const noexcept { return error == QueueError::none; }
+};
+
+// Pass the raw SDL_GetAudioStreamQueued return value. Never divide first:
+// C++ truncates -1 / 4 to zero, which would conceal an API failure as empty.
+constexpr QueueResult inspect_queued_bytes(std::int64_t raw_bytes) noexcept {
+    if (raw_bytes < 0) return {QueueError::query_failed, 0};
+    if (raw_bytes % kSourceFrameBytes != 0) {
+        return {QueueError::not_whole_source_frames, 0};
+    }
+    return {QueueError::none, raw_bytes / kSourceFrameBytes};
+}
+
+struct PushPlan {
+    QueueError error;
+    bool empty_observed;
+    std::int32_t accepted_real_frames;
+    std::int32_t dropped_real_frames;
+    std::int32_t recovery_silence_frames;
+    std::int64_t final_queued_frames;
+    constexpr bool ok() const noexcept { return error == QueueError::none; }
+};
+
+// A plan, not proof that any SDL put succeeded. The caller must count accepted
+// PCM only AFTER SDL_PutAudioStreamData reports success, and count errors apart.
+// For a valid small chunk this preserves the old empty->silence+PCM policy.
+// A real chunk that cannot fit is dropped whole, as before. Recovery silence
+// uses only the capacity remaining after accepting the real chunk, so both
+// sources of data share one upper bound. Capacity/error checks do not sum
+// unchecked inputs and remain safe for any representable raw_bytes.
+constexpr PushPlan plan_push(
+    std::int64_t raw_queued_bytes,
+    std::int32_t incoming_real_frames,
+    std::int32_t requested_lead_frames,
+    std::int32_t capacity_frames = kMaximumQueuedFrames) noexcept {
+    if (incoming_real_frames < 0 || requested_lead_frames < 0 || capacity_frames < 0) {
+        return {QueueError::invalid_argument, false, 0, 0, 0, 0};
+    }
+    const QueueResult queue = inspect_queued_bytes(raw_queued_bytes);
+    if (!queue.ok()) return {queue.error, false, 0, 0, 0, 0};
+    const std::int64_t queued = queue.source_frames;
+    if (incoming_real_frames > capacity_frames ||
+        queued > std::int64_t{capacity_frames} - incoming_real_frames) {
+        return {QueueError::none, false, 0, incoming_real_frames, 0, queued};
+    }
+    const std::int64_t headroom =
+        std::int64_t{capacity_frames} - queued - incoming_real_frames;
+    const std::int32_t silence = queued == 0
+        ? static_cast<std::int32_t>(
+              headroom < requested_lead_frames ? headroom : requested_lead_frames)
+        : 0;
+    return {QueueError::none, queued == 0, incoming_real_frames, 0, silence,
+            queued + incoming_real_frames + silence};
+}
+
+}  // namespace pal_audio_queue_policy
+
+#endif  // PAL_AUDIO_QUEUE_POLICY_H
