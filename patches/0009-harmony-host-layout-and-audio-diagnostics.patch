+// Small platform-independent candidate seams for patch 0009; no SDL or ArkUI types.
+#pragma once
+#include <algorithm>
+#include <cmath>
+
+// Result is the requested touch_layout() unit in renderer-output pixels.
+// The touch_layout() function still applies its width/height fit limits.
+inline float touch_pad_unit(int output_height_px, float display_scale, int size_percent) {
+    const float density = std::isfinite(display_scale) && display_scale > 0 ? display_scale : 1.0f;
+    const int size = std::clamp(size_percent, 50, 200); // existing [touch] size range
+    const float base = std::max(480.0f * density, 0.45f * std::max(output_height_px, 0));
+    return base * size / 100.0f;
+}
+
+struct TouchGameViewport { float x, y, w, h; };
+
+// Fit preserves desired visible-image aspect ratio; Stretch explicitly fills the output.
+// Caller owns Saturn/PAL visible-image aspect choice. The overlay does NOT use this viewport.
+inline TouchGameViewport touch_game_viewport(int output_width, int output_height,
+                                            float desired_aspect, bool stretch) {
+    if (output_width <= 0 || output_height <= 0) return {0, 0, 0, 0};
+    const float w = static_cast<float>(output_width), h = static_cast<float>(output_height);
+    if (stretch) return {0, 0, w, h};
+    if (!std::isfinite(desired_aspect) || desired_aspect <= 0) desired_aspect = 4.0f / 3.0f;
+    float rw = w, rh = rw / desired_aspect;
+    if (rh > h) { rh = h; rw = rh * desired_aspect; }
+    return {(w - rw) / 2.0f, (h - rh) / 2.0f, rw, rh};
+}
