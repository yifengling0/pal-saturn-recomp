     if (g_status == ST_PLAY) {
-        uint64_t rate = g_audio_play ? 75 : 150 * 2;
+        uint64_t rate = g_audio_play ? 75 : 300ull * g_data_cd_speed;
         uint64_t due = (now - g_play_t0) * rate / 1000000000ull;
         while (g_play_done < due && g_status == ST_PLAY) {
