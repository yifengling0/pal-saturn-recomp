# pal_disc_identity.cmake already verifies the exact original PROG.BIN SHA.
# Also require the actual linked generation to contain precisely one hook.
get_target_property(_pal_obstacle_root recomp SOURCE_DIR)
get_target_property(_pal_obstacle_sources recomp SOURCES)
set(_pal_obstacle_count 0)
set(_pal_obstacle_line "    c.r[3] = 0x3u; sh2_hook(c, 0x06033752u);  // 06033752 mov #3,r3")
foreach(_pal_source IN LISTS _pal_obstacle_sources)
  if(_pal_source MATCHES "\\.cpp$")
    get_filename_component(_pal_path "${_pal_source}" ABSOLUTE BASE_DIR "${_pal_obstacle_root}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_pal_path}")
    file(STRINGS "${_pal_path}" _pal_lines REGEX "sh2_hook\\(c, 0x06033752u\\)")
    foreach(_pal_line IN LISTS _pal_lines)
      if(NOT _pal_source MATCHES "(^|/)p_prog_[0-9]+\\.cpp$")
        message(FATAL_ERROR "PAL obstacle-stop hook outside PROG")
      endif()
      if(NOT _pal_line STREQUAL _pal_obstacle_line)
        message(FATAL_ERROR "PAL obstacle-stop hook instruction changed")
      endif()
      math(EXPR _pal_obstacle_count "${_pal_obstacle_count} + 1")
    endforeach()
  endif()
endforeach()
if(NOT _pal_obstacle_count EQUAL 1)
  message(FATAL_ERROR "PAL obstacle-stop hook missing/duplicated; regenerate game code")
endif()
target_compile_definitions(${PAL_GAME_TARGET} PRIVATE PAL_OBSTACLE_HOOK_VERIFIED=1)
unset(_pal_obstacle_root)
unset(_pal_obstacle_sources)
unset(_pal_obstacle_count)
unset(_pal_obstacle_line)
unset(_pal_source)
unset(_pal_path)
unset(_pal_lines)
unset(_pal_line)
