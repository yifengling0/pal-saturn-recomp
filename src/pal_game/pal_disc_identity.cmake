# Building this game-specific fix requires unmodified, privately extracted
# Taiwan T-37401H V1.000 assets. No game data is embedded by this check.
# Keep this gate common to the desktop saturn and Harmony libmain targets.
get_filename_component(_pal_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
foreach(_pal_pair IN ITEMS
    "PROG.BIN|808acfdb56a885a3949a8f3910705e077edb974d9985327e887acfba20afad6d"
    "CM.NOR|9eff4c279978567837df146719a9632876f0ef6d0440b26009d8415cc01774f3"
    "CM.IDX|a3b3d9354c0cb718a2bccbdd2835ef3be1a3d068da6bc288303dbd338b9b180e")
  string(REPLACE "|" ";" _pal_fields "${_pal_pair}")
  list(GET _pal_fields 0 _pal_name)
  list(GET _pal_fields 1 _pal_expected)
  set(_pal_asset "${_pal_root}/build/disc-extract/${_pal_name}")
  if(NOT EXISTS "${_pal_asset}")
    message(FATAL_ERROR "PAL medicine-chest identity requires original extracted asset: ${_pal_asset}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_pal_asset}")
  file(SHA256 "${_pal_asset}" _pal_observed)
  if(NOT _pal_observed STREQUAL _pal_expected)
    message(FATAL_ERROR "PAL medicine-chest identity mismatch: ${_pal_name}; observed=${_pal_observed}")
  endif()
endforeach()
# Inspect the sources of the recomp target actually linked by this build,
# including Harmony's separately selected generation. Old generated code must
# fail rather than silently registering a hook which is never called.
if(NOT TARGET recomp)
  message(FATAL_ERROR "PAL medicine-chest identity requires the actual recomp target")
endif()
get_target_property(_pal_recomp_root recomp SOURCE_DIR)
get_target_property(_pal_recomp_sources recomp SOURCES)
set(_pal_hook_count 0)
set(_pal_hook_line "    c.r[8] = 0x0604F210u; sh2_hook(c, 0x06028700u);  // 06028700 mov.l 0x06028720,r8\n    { const uint32_t x = c.r[8]; c.pr = 0x06028706u;")
foreach(_pal_source IN LISTS _pal_recomp_sources)
  if(_pal_source MATCHES "(^|/)p_prog_[0-9]+\\.cpp$")
    get_filename_component(_pal_source_path "${_pal_source}" ABSOLUTE BASE_DIR "${_pal_recomp_root}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_pal_source_path}")
    file(READ "${_pal_source_path}" _pal_source_text)
    string(FIND "${_pal_source_text}" "${_pal_hook_line}" _pal_found)
    while(NOT _pal_found EQUAL -1)
      math(EXPR _pal_hook_count "${_pal_hook_count} + 1")
      string(LENGTH "${_pal_hook_line}" _pal_hook_length)
      math(EXPR _pal_next "${_pal_found} + ${_pal_hook_length}")
      string(SUBSTRING "${_pal_source_text}" ${_pal_next} -1 _pal_source_text)
      string(FIND "${_pal_source_text}" "${_pal_hook_line}" _pal_found)
    endwhile()
  endif()
endforeach()
if(NOT _pal_hook_count EQUAL 1)
  message(FATAL_ERROR "PAL medicine-chest hook missing or duplicated in actual recomp target; regenerate game code (do not reuse old --skip-learn output)")
endif()
target_compile_definitions(${PAL_GAME_TARGET} PRIVATE PAL_MEDICINE_ASSETS_VERIFIED=1)
unset(_pal_root)
unset(_pal_pair)
unset(_pal_fields)
unset(_pal_name)
unset(_pal_expected)
unset(_pal_asset)
unset(_pal_observed)
unset(_pal_recomp_root)
unset(_pal_recomp_sources)
unset(_pal_hook_count)
unset(_pal_hook_line)
unset(_pal_source)
unset(_pal_source_path)
unset(_pal_source_text)
unset(_pal_found)
unset(_pal_hook_length)
unset(_pal_next)
